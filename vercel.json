{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "devCommand": "vite --port $PORT",
  "rewrites": [
    { "source": "/apiTAG", "destination": "/api/tag" },
    { "source": "/register", "destination": "/api/register" },
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ]
}